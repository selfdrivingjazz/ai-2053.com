// https://ai-2053.com: Cloudflare Workers static assets, no Worker code and no build step.
// The site is public/ exactly as committed (see public/.assetsignore, _headers, _redirects).
// Deploy from a clean checkout of main: npx wrangler@4 deploy
{
  "name": "ai-2053-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // ai-2053.com and www both serve the site; the canonical URL is https://ai-2053.com/.
  "routes": [
    { "pattern": "ai-2053.com/*", "zone_name": "ai-2053.com" },
    { "pattern": "www.ai-2053.com/*", "zone_name": "ai-2053.com" }
  ],
  "workers_dev": true,
  "preview_urls": false
}
