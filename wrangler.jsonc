// https://ai-2053.com: Cloudflare Workers static assets, no Worker code and no build step.
// The site is public/ exactly as committed (see public/.assetsignore, _headers, _redirects).
// Deploy from a clean checkout of main: npx wrangler@4 deploy
{
  "name": "ai-2053-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "preview_urls": false
}
